# Xcode. DerivedData* rather than DerivedData/ because the device build goes
# somewhere of its own — the exact trap this catches is a build directory named
# a step away from the ignored one, which is untracked and therefore invisible
# until it is committed.
DerivedData*/
build/
build-device/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
.build/

# Secrets. The app holds none any more, but the line stays so a stray file
# can't be committed by accident.
*.secret

# Claude Code's local session state. It is this machine's working notes, not
# the project's — and being untracked, it was one stray `git add -A` away from
# being committed by accident.
.claude/

# The design bundle stays on disk and out of the repo. It is the reference
# the app was built from — the mockups, the handoff, the data-model spec —
# and it is not source. Anyone picking this up needs it handed to them
# separately.
design/
build-sim/
