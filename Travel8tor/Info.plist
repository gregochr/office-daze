<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately near-empty. GENERATE_INFOPLIST_FILE merges the INFOPLIST_KEY_*
	  build settings into this file at build time, so simple keys belong there.

	  This file exists for the keys that are nested structures and cannot be
	  expressed as build settings:

	    CFBundleDocumentTypes  — stage 4. Registers .pkpass, images and PDFs so
	                             Travel8tor appears in the share sheet's app row.
	                             This replaces the share extension, which would
	                             have needed App Groups and a paid account.
	    UIBackgroundModes      — stage 5. Location updates for region monitoring.

	  Space Mono goes in UIAppFonts here in stage 2.
	-->
</dict>
</plist>
